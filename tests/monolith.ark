// tests/monolith.ark

fn[gpu] add_kernel(A: tensor<f32>, B: tensor<f32>, C: tensor<f32>) {
    // CORRECT SYNTAX: No parens around 'i in C'
    // The parser sees 'par', then 'i', then expects 'in'.
    par i in C {
        C[i] = A[i] + B[i];
    }
}

fn[host] main() -> i32 !IO {
    let size = 1024;

    // Allocate on Device 0 (Unified Memory / Managed Buffer)
    let A = allocof<f32>(size) @gpu:0;
    let B = allocof<f32>(size) @gpu:0;
    let C = allocof<f32>(size) @gpu:0;

    print "=== TEST: GPU KERNEL LAUNCH ===";

    // 1. Initialize Data (Host Write)
    print "Initializing input tensors...";
    for i in 0..size {
        A[i] = 10.0;
        B[i] = 20.0;
        C[i] = 0.0; // Clear output
    }

    // 2. Launch Kernel
    print "Launching GPU kernel...";
    C <- add_kernel(A, B, C) as t1;
    
    // 3. Sync
    await t1;

    // 4. Verify Results (Host Read)
    print "Verifying results...";
    let errors = 0;
    
    for i in 0..size {
        let val = C[i];
        let expected = 30.0;
        
        if (val != expected) {
            print "Error at index", i, ": expected", expected, "got", val;
            errors = errors + 1;
            
            if (errors > 5) {
                return 1;
            }
        }
    }

    if (errors == 0) {
        print "SUCCESS: GPU Kernel addition verified correctly over", size, "elements.";
        return 0;
    } else {
        print "FAILURE: Found", errors, "errors.";
        return 1;
    }

    return 0;
}