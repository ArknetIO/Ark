// tests/remote.ark

fn[gpu] add_kernel(A: tensor<f32>, B: tensor<f32>, C: tensor<f32>) {
    par i in C {
        C[i] = A[i] + B[i];
    }
}

fn[host] main() -> i32 !IO {
    let route = "f1690ce0-db6b-49b6-a5bf-ca879a2cb602";

    let preset = runtime{
        target: route,
        endpoint: route,
        token: "",
        timeout_ms: 30000,
        max_burn_usd: 1.0
    };

    let size = 1024;

    let A = allocof<f32>(size) @gpu:"f1690ce0-db6b-49b6-a5bf-ca879a2cb602";
    let B = allocof<f32>(size) @gpu:route;
    let C = allocof<f32>(size) @runtime preset;

    print "=== TEST: REMOTE GPU BUFFER ALLOCATION FORMS ===";
    print "A: @gpu:\"f1690ce0-db6b-49b6-a5bf-ca879a2cb602\"";
    print "B: @gpu:route";
    print "C: @runtime preset";

    print "Initializing input tensors...";
    for i in 0..size {
        A[i] = 10.0;
        B[i] = 20.0;
        C[i] = 0.0;
    }

    print "Launching GPU kernel...";
    C <- add_kernel(A, B, C) as t1 @runtime preset;
    await t1;

    print "Verifying results...";
    let errors = 0;

    for i in 0..size {
        let val = C[i];
        let expected = 30.0;

        if (val != expected) {
            print "Error at index", i, ": expected", expected, "got", val;
            errors = errors + 1;

            if (errors > 5) {
                print "... stopping verification (too many errors).";
                return 1;
            }
        }
    }

    if (errors == 0) {
        print "SUCCESS: mixed allocation forms verified correctly over", size, "elements.";
        return 0;
    } else {
        print "FAILURE: Found", errors, "errors.";
        return 1;
    }

    return 0;
}