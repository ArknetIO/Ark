// syntax: fn name() -> return_type !CAP1 !CAP2 { ... }

fn[host] main() -> i32 !FS !IO {
    print "=== TEST: FILESYSTEM ===";
    
    let filename = "ark_fs_test.txt";
    let content = "Arklang FS Check: OK---2";

    // 1. Write Atomic
    print "Writing:", filename;
    FS.save(filename, content);

    // 2. Read Back
    print "Reading:", filename;
    let data = FS.load(filename);
    
    print "Result content:";
    print data;

    return 0;
}


