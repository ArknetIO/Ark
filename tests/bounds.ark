

fn[host] main() -> i32 {
    print "=== BOUNDS & LEN TEST ===";
    let v = [10, 20, 30];
    
    // Test .len
    print "Vector Length (Expect 3):", v.len;
    
    let s = v[1..3];
    print "Slice Length (Expect 2):", s.len;
    
    print "Accessing valid index (Expect 20):", s[0];
    
    print "Attempting OOB Access (Expect Crash)...";
    // This MUST cause a Trap (Aborted)
    print s[5];
    
    return 0;
}